// otp_create_user.pb.js - Hook para crear usuario al solicitar OTP

onRecordRequestOTPRequest((e) => {
    // Verificar si el usuario NO existe
    if (!e.record) {
        try {
            // Obtener datos del cuerpo de la petición
            const body = e.requestInfo().body;
            const email = body["email"];
            const phone = body["phone"] || "";
            const name = body["name"] || "Usuario automático";
            
            console.log("📝 Creando usuario automático para:", email);
            
            // Crear nuevo registro de usuario
            const record = new Record(e.collection);
            
            // Configurar campos obligatorios
            record.setEmail(email);
            record.set("phone", phone);
            record.set("name", name);
            record.set("role", "client");
            record.set("verified", false);
            
            // Generar contraseña aleatoria segura (nunca se usará directamente)
            const randomPassword = $security.randomString(30);
            record.setPassword(randomPassword);
            
            // Guardar el usuario en la base de datos
            e.app.save(record);
            
            // Asignar el usuario creado al evento para que PocketBase genere el OTP
            e.record = record;
            
            console.log("✅ Usuario creado exitosamente con ID:", record.getId());
            
        } catch (error) {
            console.error("❌ Error al crear usuario:", error.message);
            console.error("Detalles completos:", error);
        }
    }
    
    // 🔥 IMPORTANTE: Mostrar el código OTP generado en los logs
    // PocketBase pone el código OTP en e.otp.password cuando se genera
    if (e.otp) {
        console.log("======================================");
        console.log("🔑 CÓDIGO OTP GENERADO:", e.otp.password);
        console.log("📧 Para email:", e.record?.get("email") || "desconocido");
        console.log("======================================");
    } else {
        console.log("⚠️ No se pudo obtener el OTP (e.otp es undefined)");
    }
    
    // Continuar con el flujo normal de OTP
    return e.next();
}, "users");

console.log("🚀 Hook de creación automática de usuarios cargado correctamente");
